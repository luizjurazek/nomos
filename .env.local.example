# Google Cloud service account with access to the Google Sheets API.
# Create one in a GCP project: IAM & Admin > Service Accounts > Create Service Account,
# then Keys > Add Key > JSON. Enable the "Google Sheets API" for that project.
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
# Paste the JSON key's "private_key" value, keeping the literal \n line breaks.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# One spreadsheet per year — share each sheet with the service account email above (Editor access).
# The ID is the long string in the sheet's URL: https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SPREADSHEET_IDS={"2026":"<spreadsheet id for 2026>"}

# Simple shared-password gate for the app (just the two of you, no full auth provider).
# The password is never stored in plain text — only its bcrypt hash. Generate one with:
#   node -e "console.log(require('bcryptjs').hashSync('sua-senha', 10))"
# IMPORTANT: the bcrypt hash is full of "$" (e.g. $2b$10$...), and Next.js's .env loader
# expands "$VAR" as a variable reference. Escape every "$" as "\$" when you paste the hash
# in here, or it gets silently corrupted and login will never match.
APP_PASSWORD_HASH=
# Signs the session cookie (a JWT) — generate with `openssl rand -base64 32`.
SESSION_SECRET=
